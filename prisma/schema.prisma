generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  audits    Audit[]
}

model Audit {
  id         String       @id @default(cuid())
  title      String
  type       String       @default("Measurement assurance")
  status     AuditStatus  @default(SCHEDULED)
  targetDate DateTime?
  clientId   String
  client     Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  record     AuditRecord?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([status, updatedAt])
  @@index([clientId])
}

enum AuditStatus {
  SCHEDULED
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

model AuditRecord {
  id        String   @id @default(cuid())
  auditId   String   @unique
  audit     Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)
  // JSON is temporary v0.3 storage. Normalized requirements and evidence follow in v0.4.
  content   Json
  updatedAt DateTime @updatedAt
}
