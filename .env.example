# SURFACE Audit: LOCAL DEVELOPMENT ONLY. Do not expose to network or use customer data.
DATABASE_URL="postgresql://surfaceaudit:replace-me@localhost:5432/surface_audit?schema=public"
# Keep disabled unless running a disposable local PostgreSQL database.
SURFACE_AUDIT_ENABLE_LOCAL_API="false"
NEXT_PUBLIC_SURFACE_AUDIT_STORAGE_MODE="browser"

# v1.3: individual operators are stored in PostgreSQL.
# After applying versioned migrations, run:
# node scripts/create-local-operator.mjs local-admin ADMIN
# node scripts/create-local-operator.mjs auditor EDITOR
# node scripts/create-local-operator.mjs reviewer REVIEWER
# A standalone CLI script needs SURFACE_AUDIT_ENABLE_LOCAL_API=true in the shell.
# The older shared-admin username, password hash and session secret are obsolete.
