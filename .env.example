# Local development ONLY. Never deploy this demo API publicly.
DATABASE_URL="postgresql://surfaceaudit:replace-me@localhost:5432/surface_audit?schema=public"
SURFACE_AUDIT_ENABLE_LOCAL_API="false"
NEXT_PUBLIC_SURFACE_AUDIT_STORAGE_MODE="browser"

# v0.4 local-only single-operator access (not production authentication)
SURFACE_AUDIT_ADMIN_USERNAME="local-admin"
# Generate with: node scripts/generate-local-password.mjs
SURFACE_AUDIT_ADMIN_PASSWORD_SCRYPT=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SURFACE_AUDIT_SESSION_SECRET=""
